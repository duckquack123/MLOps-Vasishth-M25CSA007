FROM python:3.10-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    numpy==1.26.4 \
    torch==2.3.0 \
    transformers==4.41.2 \
    datasets==2.19.1 \
    evaluate==0.4.2 \
    accelerate==0.30.1 \
    huggingface_hub==0.23.4 \
    sentencepiece \
    protobuf \
    scikit-learn

COPY src/ ./src

CMD ["python", "src/evaluate_model.py"]

